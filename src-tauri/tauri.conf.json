{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Key Trigger Countdown",
  "version": "1.1.0",
  "identifier": "com.yihui.key-trigger-countdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Countdown",
        "label": "main",
        "width": 360,
        "height": 284,
        "resizable": false,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
